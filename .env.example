DATABASE_URL=sqlite:///./crm_dev.db
JWT_SECRET=REPLACE_WITH_64_CHARACTER_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_INITIAL_PASSWORD
CORS_ORIGINS=http://localhost:5173

# Phase 1D - Official WhatsApp / Chatwoot, never commit actual values.
META_VERIFY_TOKEN=REPLACE_WITH_RANDOM_VERIFY_TOKEN
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me-long-random-secret
STORAGE_BUCKET=supplycrm-private
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=0
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# 1G: maximum inbound media object size (bytes)
META_MAX_MEDIA_BYTES=16000000

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-long-random-secret
